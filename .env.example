# ---- Server ----
# NODE_ENV defaults to "development". Hosting platforms usually set this
# themselves (e.g. production); in development it also controls which CORS
# origins are allowed. Valid values: development | production | test.
NODE_ENV=development

# Port the Express API listens on (Vite dev proxies /api to this).
PORT=3001

# Comma-separated list of allowed browser origins for CORS.
# Leave empty in production when the client is served by this app (same origin).
# Example: CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=

# ---- Weather provider (OpenWeatherMap) ----
# Sign up for a free key at https://openweathermap.org/api
WEATHER_API_KEY=

# Base URL for the OpenWeatherMap API (do not include trailing data path segment).
WEATHER_API_BASE_URL=https://api.openweathermap.org/data

# Base URL for the OpenWeatherMap Geocoding API (coordinate-first location search).
WEATHER_GEO_BASE_URL=https://api.openweathermap.org/geo

# ---- AI provider (server-side only; the key is never exposed to the browser) ----
# Supported values: "openai-compatible" (OpenAI, OpenRouter, Groq, Ollama, ...) or "anthropic".
AI_PROVIDER=openai-compatible

# Leave AI_PROVIDER empty (or these keys empty) to run the app without AI.
AI_API_KEY=

# Base URL of the AI API. Defaults vary by provider when left empty:
#   openai-compatible -> https://api.openai.com/v1
#   anthropic         -> https://api.anthropic.com/v1
AI_BASE_URL=

# Model to use. Provider-specific default is used when left empty.
AI_MODEL=

# Optional vision-capable model for the Camera / Files "analyse this image"
# features (only OpenAI-compatible providers supported). Leave empty to disable
# image analysis — the UI then explains the feature is unavailable.
# Example: AI_IMAGE_MODEL=llama-3.2-11b-vision-preview
AI_IMAGE_MODEL=

# ---- Client (build-time only, never a secret) ----
# Optional override for the API base URL baked into the client bundle at build
# time. Leave empty to use same-origin (/api) — in dev Vite proxies /api to the
# server, in production the server serves the client. Only set this if you host
# the client separately from the API.
# Example: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# ---- Authentication (accounts, sessions, email codes) ----
# SQLite database file for users, sessions and verification codes. Relative
# paths resolve from the server workspace. Leave empty for the default
# `server/data/weathergpt.db`.
AUTH_DB_PATH=

# Set a strong random value to HMAC session tokens at rest. When empty a random
# key is generated at boot, so all sessions end on each server restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Session lifetime in days (default 7). Sessions are valid for up to this long,
# extended on each active request beyond the halfway mark.
AUTH_SESSION_DAYS=7

# Send the session cookie with the Secure flag (require HTTPS). Recommended in
# production behind a TLS terminator; leave off for http://localhost.
AUTH_COOKIE_SECURE=false

# Minimum seconds between verification-code resends (default 60).
AUTH_VERIFY_RESEND_SECONDS=60

# Public base URL of this server, used to build OAuth redirect_uri callbacks
# (e.g. https://weathergpt.example.com). Required for Google/GitHub/Apple sign-in.
# Example: APP_URL=https://weathergpt.example.com
APP_URL=

# Path prefix of the SPA under APP_URL (default empty = root).
CLIENT_BASE=

# ---- Email delivery for verification / reset codes (nodemailer SMTP) ----
# Leave SMTP_HOST empty to use "developer mode": codes are printed to the server
# console (never sent to the client) instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WeatherGPT <no-reply@weathergpt.app>
# Use SSL/TLS from the first connection (true for implicit TLS ports like 465).
SMTP_SECURE=false

# ---- OAuth providers (each optional; unconfigured buttons are hidden) ----
# Register the app and let it redirect to: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple Sign-in: Team ID + a Sign in with Apple key (ES256). The private key is
# the full PEM block (newlines can stay literally in the value).
# Redirect URI: <APP_URL>/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=